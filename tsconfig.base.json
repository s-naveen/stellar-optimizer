{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es6",
    "module": "nodenext",
    "lib": ["es2021", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "strictNullChecks": true,
    "typeRoots": ["./node_modules/@types", "./node_modules", "./types"],
    "paths": {
      "@genshin-optimizer/biome": ["./plugin/biome/src/index.ts"],
      "@genshin-optimizer/common/database": [
        "./libs/common/database/src/index.ts"
      ],
      "@genshin-optimizer/common/database-ui": [
        "./libs/common/database-ui/src/index.ts"
      ],
      "@genshin-optimizer/common/img-util": [
        "./libs/common/img-util/src/index.ts"
      ],
      "@genshin-optimizer/common/localization": [
        "./libs/common/localization/src/index.ts"
      ],
      "@genshin-optimizer/common/pipeline": [
        "./libs/common/pipeline/src/index.ts"
      ],
      "@genshin-optimizer/common/plugin": ["./libs/common/plugin/src/index.ts"],
      "@genshin-optimizer/common/react-util": [
        "./libs/common/react-util/src/index.ts"
      ],
      "@genshin-optimizer/common/svgicons": [
        "./libs/common/svgicons/src/index.ts"
      ],
      "@genshin-optimizer/common/ui": ["./libs/common/ui/src/index.ts"],
      "@genshin-optimizer/common/util": ["./libs/common/util/src/index.ts"],
      "@genshin-optimizer/gi/art-scanner": [
        "./libs/gi/art-scanner/src/index.ts"
      ],
      "@genshin-optimizer/gi/assets": ["./libs/gi/assets/src/index.ts"],
      "@genshin-optimizer/gi/assets-data": [
        "./libs/gi/assets-data/src/index.ts"
