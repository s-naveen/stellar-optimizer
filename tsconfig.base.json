      "@genshin-optimizer/gi/i18n": ["./libs/gi/i18n/src/index.ts"],
      "@genshin-optimizer/gi/keymap": ["./libs/gi/keymap/src/index.ts"],
      "@genshin-optimizer/gi/localization": [
        "./libs/gi/localization/src/index.ts"
      ],
      "@genshin-optimizer/gi/page-archive": [
        "./libs/gi/page-archive/src/index.tsx"
      ],
      "@genshin-optimizer/gi/page-artifacts": [
        "./libs/gi/page-artifacts/src/index.tsx"
      ],
      "@genshin-optimizer/gi/page-characters": [
